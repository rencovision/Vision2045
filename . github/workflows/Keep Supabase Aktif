
on:
  schedule:
    - cron: "0 1 */3 * *"   # tiap 3 hari, 01:00 UTC (09:00 WITA)
  workflow_dispatch:         # bisa dijalankan manual dari tab Actions

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Supabase (baca tabel renco_store)
        env:
          SB_URL: https://xmbknvdzfikkpyokqvig.supabase.co
          SB_KEY: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhtYmtudmR6Zmlra3B5b2txdmlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA4NDM1NjQsImV4cCI6MjEwNjQxOTU2NH0.he1QTcPNNN-EGOGUi3axAEQ8gP-QgbKUvjW6NGM2hdw
        run: |
          code=$(curl -s -o /tmp/out.json -w "%{http_code}" \
            "$SB_URL/rest/v1/renco_store?select=key,updated_at" \
            -H "apikey: $SB_KEY" \
            -H "Authorization: Bearer $SB_KEY")
          echo "HTTP $code"
          cat /tmp/out.json
          if [ "$code" != "200" ]; then
            echo "::error::Supabase tidak merespons normal (HTTP $code). Cek apakah project sedang dijeda."
            exit 1
          fi
